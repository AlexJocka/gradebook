# Скопируйте в .env и задайте свои значения: cp .env.example .env
POSTGRES_PASSWORD=
SECRET_KEY=
# Пароли пользователей admin и methodist/teacher; если пусто, будут сгенерированы и выведены в журнал
ADMIN_PASSWORD=
DEMO_PASSWORD=
# true - заполнить БД демонстрационными данными при первом запуске
SEED_DEMO=false
APP_ENV=dev
